<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\TransportAnalyzer.Ingestion\TransportAnalyzer.Ingestion.csproj" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../data/**" Exclude="../../data/inbox/**" Link="data/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.7.2" />
  </ItemGroup>

  <!-- wwwroot is generated by the web build and gitignored; the host requires the folder to exist. -->
  <Target Name="EnsureWwwroot" BeforeTargets="BeforeBuild;GenerateStaticWebAssetsManifest">
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
  </Target>

</Project>
